<section class="standard-form tab {{tabs.outcomes.cssClass}}" data-tab="outcomes" data-group="primary">
<h2>Total Success</h2>
<prose-mirror name="system.outcomes.totalSuccess" class="journal-page-content" value="{{system.outcomes.totalSuccess}}"
    data-document-uuid="{{ uuid }}" collaborate></prose-mirror>
<h2>Partial Success</h2>
<prose-mirror name="system.outcomes.partialSuccess" class="journal-page-content" value="{{system.outcomes.partialSuccess}}"
    data-document-uuid="{{ uuid }}" collaborate></prose-mirror>
<h2>Total Failure</h2>
<prose-mirror name="system.outcomes.totalFailure" class="journal-page-content" value="{{system.outcomes.totalFailure}}"
    data-document-uuid="{{ uuid }}" collaborate></prose-mirror>
</section>
